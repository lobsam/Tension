{
  "name": "tension_site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "smoke:routes": "node scripts/smoke-routes.mjs",
    "smoke:responsive": "node scripts/responsive-smoke.mjs",
    "smoke:release": "npm run build && npm run smoke:routes && npm run smoke:responsive",
    "lint": "npm run lint:check",
    "lint:check": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs --ignore-path .gitignore",
    "lint:fix": "npm run lint:check -- --fix",
    "format": "npm run format:fix",
    "format:check": "prettier --check . --ignore-path .gitignore",
    "format:fix": "prettier --write . --ignore-path .gitignore"
  },
  "dependencies": {
    "axios": "^1.15.1",
    "bootstrap": "^5.3.8",
    "csvtojson": "^2.0.14",
    "pdfjs-dist": "^4.10.38",
    "pinia": "^2.3.1",
    "vue": "^3.5.32",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.16.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/eslint-config-prettier": "^9.0.0",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.33.0",
    "playwright": "^1.59.1",
    "prettier": "^3.8.3",
    "vite": "^5.4.21"
  }
}
